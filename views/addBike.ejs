<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <title>Přidat kolo</title>
</head>
<body>
    <h1>Přidat nové kolo do databáze</h1>
    
    <form action="/add" method="POST" enctype="multipart/form-data">
        <div>
            <label>Název kola:</label><br>
            <input type="text" name="name" required>
        </div>
        <br>
        <div>
            <label>Typ:</label><br>
            <select name="type">
                <option value="Celoodpružené">Celoodpružené</option>
                <option value="Hardtail">Hardtail</option>
            </select>
        </div>
        <br>
        <div>
            <label>Třída vybavení:</label><br>
            <select name="level">
                <option value="Základní">Základní</option>
                <option value="Střední">Střední</option>
                <option value="Nejlepší">Nejlepší</option>
            </select>
        </div>
        <br>
        <div>
            <label>Popis / Komponenty:</label><br>
            <textarea name="description" rows="4" required></textarea>
        </div>
        <br>
        <div>
            <label>Fotka kola:</label><br>
            <input type="file" name="image" accept="image/*">
        </div>
        <br>
        <button type="submit">Uložit kolo</button>
    </form>

    <br>
    <a href="/">Zpět na seznam</a>
</body>
</html>