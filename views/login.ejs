<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Přihlášení | Databáze kol</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <div class="form-container" style="margin-top: 100px;">
        <h1 style="text-align: center; margin-bottom: 30px;">Přihlášení do databáze</h1>
        
        <form action="/login" method="POST">
            <div class="form-group">
                <label>Uživatelské jméno:</label>
                <input type="text" name="username" required>
            </div>
            
            <div class="form-group">
                <label>Heslo:</label>
                <input type="password" name="password" required>
            </div>
            
            <button type="submit" class="btn btn-primary" style="width: 100%; font-size: 1.1rem; padding: 15px; margin-top: 10px;">Přihlásit se</button>
        </form>
        
        <div style="text-align: center; margin-top: 20px;">
            <p style="color: #636e72;">Nemáš ještě účet? <a href="/register" style="color: #27ae60; font-weight: bold; text-decoration: none;">Zaregistruj se</a></p>
        </div>
    </div>

</body>
</html>