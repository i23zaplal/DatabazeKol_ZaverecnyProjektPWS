<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upravit kolo</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <div class="header">
        <h1>Upravit detaily kola</h1>
        <a href="/" class="btn btn-outline">Zpět na seznam</a>
    </div>

    <div class="form-container">
        <form action="/edit/<%= bike._id %>" method="POST" enctype="multipart/form-data">
            <div class="form-group">
                <label>Název / Model:</label>
                <input type="text" name="name" value="<%= bike.name %>" required>
            </div>

            <div class="form-group">
                <label>Cena:</label>
                <input type="text" name="price" value="<%= bike.price %>" required>
            </div>
            
            <div class="form-group">
                <label>Typ:</label>
                <select name="type">
                    <option value="Celoodpružené" <%= bike.type === 'Celoodpružené' ? 'selected' : '' %>>Celoodpružené</option>
                    <option value="Hardtail" <%= bike.type === 'Hardtail' ? 'selected' : '' %>>Hardtail</option>
                </select>
            </div>
            
            <div class="form-group">
                <label>Třída / Náročnost:</label>
                <select name="level">
                    <option value="Základní" <%= bike.level === 'Základní' ? 'selected' : '' %>>Základní</option>
                    <option value="Střední" <%= bike.level === 'Střední' ? 'selected' : '' %>>Střední</option>
                    <option value="Nejlepší" <%= bike.level === 'Nejlepší' ? 'selected' : '' %>>Nejlepší</option>
                </select>
            </div>
            
            <div class="form-group">
                <label>Popis / Podrobnosti:</label>
                <textarea name="description" rows="4" required><%= bike.description %></textarea>
            </div>
            
            <div class="form-group">
                <label>Změnit fotku:</label>
                <input type="file" name="image" accept="image/*">
            </div>
            
            <button type="submit" class="btn btn-primary" style="width: 100%;">Uložit změny</button>
        </form>
    </div>
</body>
</html>