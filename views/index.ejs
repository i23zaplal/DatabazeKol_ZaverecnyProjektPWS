<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <title>Databáze horských kol</title>
</head>
<body>
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <h1>Moje databáze kol</h1>
        <a href="/logout">Odhlásit se</a>
    </div>

    <a href="/add" style="display: inline-block; margin-bottom: 20px; padding: 10px; background: #28a745; color: white; text-decoration: none;">+ Přidat nové kolo</a>

    <hr>

    <% if (bikes.length > 0) { %>
        <div style="display: flex; flex-wrap: wrap; gap: 20px;">
            <% bikes.forEach(bike => { %>
                <div style="border: 1px solid #ccc; padding: 15px; width: 300px;">
                    <h3><%= bike.name %></h3>
                    <p><strong>Typ:</strong> <%= bike.type %></p>
                    <p><strong>Třída:</strong> <%= bike.level %></p>
                    <p><%= bike.description %></p>

                    <div style="margin-top: 15px; display: flex; gap: 10px;">
    <a href="/edit/<%= bike._id %>" style="padding: 5px 10px; background: #ffc107; color: black; text-decoration: none;">Upravit</a>
    
    <form action="/delete/<%= bike._id %>" method="POST" style="display: inline;">
        <button type="submit" style="padding: 5px 10px; background: #dc3545; color: white; border: none; cursor: pointer;" onclick="return confirm('Opravdu to chceš smazat?')">Smazat</button>
    </form>
</div>
                    
                    <% if (bike.image) { %>
                        <img src="/uploads/<%= bike.image %>" alt="<%= bike.name %>" style="max-width: 100%; height: auto;">
                    <% } %>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <p>Zatím tu nejsou žádná kola. Přidej první!</p>
    <% } %>
</body>
</html>