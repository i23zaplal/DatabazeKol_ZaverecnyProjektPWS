<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Databáze horských kol</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <div class="header">
        <h1>Moje databáze kol</h1>
        <a href="/logout" class="btn btn-outline">Odhlásit se</a>
    </div>

    <a href="/add" class="btn btn-primary" style="margin-bottom: 30px;">+ Přidat nové kolo</a>

    <% if (bikes.length > 0) { %>
        <div class="grid-container">
            <% bikes.forEach(bike => { %>
                <div class="card">
                    <% if (bike.image) { %>
                        <img src="/uploads/<%= bike.image %>" alt="<%= bike.name %>" class="card-img">
                    <% } else { %>
                        <img src="https://via.placeholder.com/400x220?text=Bez+fotografie" alt="No image" class="card-img">
                    <% } %>
                    
                    <div class="card-body">
                        <h3 class="card-title"><%= bike.name %></h3>
                        
                        <div>
                            <span class="card-badge"><%= bike.type %></span>
                            <span class="card-badge"><%= bike.level %></span>
                        </div>
                        
                        <p class="card-text"><%= bike.description %></p>
                        
                        <div class="card-actions">
                            <a href="/edit/<%= bike._id %>" class="btn btn-warning">Upravit</a>
                            
                            <form action="/delete/<%= bike._id %>" method="POST" style="margin: 0;">
                                <button type="submit" class="btn btn-danger" onclick="return confirm('Opravdu chceš toto kolo trvale smazat?')">Smazat</button>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div style="text-align: center; padding: 50px; background: white; border-radius: 16px;">
            <h2 style="color: #b2bec3;">Zatím tu žádná kola nejsou</h2>
            <p style="color: #636e72; margin-top: 10px;">Klikni na zelené tlačítko a přidej svůj první sjezďák nebo hardtail!</p>
        </div>
    <% } %>

</body>
</html>